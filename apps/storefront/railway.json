{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/storefront/Dockerfile",
    "watchPatterns": [
      "apps/storefront/**",
      "package.json",
      "package-lock.json"
    ]
  },
  "deploy": {
    "startCommand": "node /app/node_modules/next/dist/bin/next start -p 8000",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
