{
  "name": "@dtc/backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "configure:kenya": "medusa exec ./src/scripts/configure-kenya-market.ts",
    "seed:demo-merchants": "medusa exec ./src/scripts/seed-demo-merchants.ts",
    "seed:mpesa-registry": "medusa exec ./src/scripts/seed-mpesa-registry.ts",
    "onboard:mpesa": "medusa exec ./src/scripts/mpesa-onboarding-cli.ts",
    "draft:photo-test": "node --use-system-ca --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/draft-from-photo-test.mjs",
    "lint": "medusa lint",
    "test": "npm run test:unit && npm run test:integration:modules:local && npm run test:integration:http:local",
    "test:ci": "npm run test:unit && npm run test:integration:modules && npm run test:integration:http",
    "test:unit": "node ./scripts/run-jest.js unit --silent --runInBand",
    "test:integration:http": "node ./scripts/run-jest.js integration:http --silent=false --runInBand --forceExit",
    "test:integration:http:local": "node ./scripts/run-integration-with-postgres.js integration:http --silent=false --runInBand --forceExit",
    "test:integration:modules": "node ./scripts/run-jest.js integration:modules --silent=false --runInBand --forceExit",
    "test:integration:modules:local": "node ./scripts/run-integration-with-postgres.js integration:modules --silent=false --runInBand --forceExit",
    "test:db:up": "docker compose -p merchant-platform-tests -f ../../docker-compose.test.yml up -d --wait test-postgres",
    "test:db:down": "docker compose -p merchant-platform-tests -f ../../docker-compose.test.yml down --volumes --remove-orphans",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.27.0",
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/admin-shared": "2.19.0",
    "@medusajs/caching": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/dashboard": "2.19.0",
    "@medusajs/draft-order": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/icons": "2.19.0",
    "@medusajs/js-sdk": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/ui": "4.2.1",
    "@tanstack/react-query": "5.64.2",
    "multer": "^2.2.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.19.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.12.11",
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@11.16.0"
}
