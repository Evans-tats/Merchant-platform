STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend
MEDUSA_FF_RBAC=true
# Public URL of this backend. Uploaded images are served from <url>/static.
MEDUSA_BACKEND_URL=http://localhost:9000

# M-PESA merchant onboarding (npm run onboard:mpesa)
# Secret for hashing verification codes. Falls back to JWT_SECRET.
MPESA_ONBOARDING_SECRET=
# Stores are created at <slug>.<MERCHANT_PLATFORM_DOMAIN>
MERCHANT_PLATFORM_DOMAIN=localhost
# Store links (View storefront, onboarding replies). With a shared storefront
# address use https://<storefront host>/?shop={hostname}
STOREFRONT_URL_TEMPLATE=http://{hostname}:8000
MERCHANT_ADMIN_URL=http://localhost:9000/app
# Owner logins are created as <msisdn>@<MPESA_ONBOARDING_LOGIN_DOMAIN>
MPESA_ONBOARDING_LOGIN_DOMAIN=merchants.mpesa.local
# Test only: makes every verification code this value. Ignored in production.
MPESA_ONBOARDING_FIXED_CODE=


DATABASE_URL=postgres://postgres:postgres@localhost:5432/merchant_platform

# Product drafts from photos (npm run draft:photo-test) and the store
# assistant in the merchant admin. Both are off when this is empty.
GEMINI_API_KEY=
