{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/backend/Dockerfile",
    "watchPatterns": [
      "apps/backend/**",
      "package.json",
      "package-lock.json"
    ]
  },
  "deploy": {
    "startCommand": "/app/node_modules/.bin/medusa start",
    "preDeployCommand": "/app/node_modules/.bin/medusa db:migrate",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "requiredMountPath": "/app/apps/backend/.medusa/server/static",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
